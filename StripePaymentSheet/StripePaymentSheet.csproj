<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0-android;net7.0-android;</TargetFrameworks>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>Anjo.Android.Stripe.PaymentSheet</PackageId>
		<PackageVersion>20.36.1</PackageVersion>
		<AssemblyVersion>20.36.1</AssemblyVersion>
		<FileVersion>20.36.1</FileVersion>
		<Version>20.36.1</Version>
		<Title>Anjo Android Stripe PaymentSheet SDK</Title>
		<Authors>Wael Anjo</Authors>
		<Owners>Wael Anjo</Owners>
		<PackageProjectUrl>https://github.com/mhdwaelanjo/Anjo.Android.Stripe</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<Description>.NET for Android (formerly Xamarin.Android) Binding Library - Stripe PaymentSheet SDK</Description>
		<PackageReleaseNotes>Stripe.PaymentSheet SDK v20.36.1</PackageReleaseNotes>
		<Copyright>Copyright (c) 2024 Wael Anjo</Copyright>
		<PackageTags>Xamarin.Android, MonoDroid, Stripe, credit cards, Payment Gateway, money</PackageTags>
		<Summary>With Stripe Payments, collect payments, make payouts, manage international payments and more.</Summary>
		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="Jars\paymentsheet-20.36.1.aar" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Xamarin.AndroidX.Activity" Version="1.8.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Activity.Compose" Version="1.8.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.7.0.2" />
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.6.1.5" />
		<PackageReference Include="Xamarin.AndroidX.Browser" Version="1.6.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Compose.Foundation" Version="1.5.4" />
		<PackageReference Include="Xamarin.AndroidX.Compose.Material" Version="1.5.4" />
		<PackageReference Include="Xamarin.AndroidX.Compose.Material.Icons.Core" Version="1.5.4" />
		<PackageReference Include="Xamarin.AndroidX.Compose.Runtime" Version="1.5.4" />
		<PackageReference Include="Xamarin.AndroidX.Compose.UI" Version="1.5.4" />
		<PackageReference Include="Xamarin.AndroidX.Compose.UI.Tooling.Preview" Version="1.5.4" />
		<PackageReference Include="Xamarin.AndroidX.Compose.UI.ViewBinding" Version="1.5.4" />
		<PackageReference Include="Xamarin.AndroidX.ConstraintLayout" Version="2.1.4.8" />
		<PackageReference Include="Xamarin.AndroidX.DataBinding.ViewBinding" Version="8.1.2.1" />
		<PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.6.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.6.2.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.6.2.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.6.2.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.6.2.2" />
		<PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.3.2" />
		<PackageReference Include="Xamarin.Google.Android.Material" Version="1.10.0.1" />
		<PackageReference Include="Xamarin.Google.Dagger" Version="2.47.0.1" />
		<PackageReference Include="Xamarin.GooglePlayServices.Wallet" Version="119.2.1.1" />
		<PackageReference Include="Xamarin.Kotlin.StdLib.Jdk7" Version="1.9.20" />
		<PackageReference Include="Xamarin.KotlinX.Coroutines.Core" Version="1.7.3.2" />
		<PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.7.3.2" />
		<PackageReference Include="Xamarin.Android.JetBrains.KotlinX_Serialization_Json_Jvm" Version="1.3.1" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\StripeCore\StripeCore.csproj" />
		<ProjectReference Include="..\StripeFinancialConnections\StripeFinancialConnections.csproj" />
		<ProjectReference Include="..\StripeLink\StripeLink.csproj" />
		<ProjectReference Include="..\StripePaymentCore\StripePaymentCore.csproj" />
		<ProjectReference Include="..\StripePaymentsUiCore\StripePaymentsUiCore.csproj" />
		<ProjectReference Include="..\StripeUiCore\StripeUiCore.csproj" />
	</ItemGroup>
</Project>