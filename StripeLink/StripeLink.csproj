<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net7.0-android;net6.0-android;</TargetFrameworks>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
	<PropertyGroup>
		<PackageId>Anjo.Android.Stripe.Link</PackageId>
		<PackageVersion>20.22.0</PackageVersion>
		<AssemblyVersion>20.22.0</AssemblyVersion>
		<FileVersion>20.22.0</FileVersion>
		<Version>20.22.0</Version>
		<Title>Anjo Android Stripe Link SDK</Title>
		<Authors>Wael Anjo</Authors>
		<Owners>Wael Anjo</Owners>
		<PackageProjectUrl>https://github.com/mhdwaelanjo/Anjo.Android.Stripe</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<Description>Xamarin Android Binding Library - Stripe Link</Description>
		<PackageReleaseNotes>Stripe.Link SDK v20.22.0</PackageReleaseNotes>
		<Copyright>Copyright (c) 2023 Wael Anjo</Copyright>
		<PackageTags>Xamarin.Android, MonoDroid, Stripe, credit cards, Payment Gateway, money</PackageTags>
		<Summary>With Stripe Payments, collect payments, make payouts, manage international payments and more.</Summary>
		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
  <ItemGroup>
    <None Remove="Jars\link-20.22.0.aar" />
  </ItemGroup>
	<ItemGroup>
		<PackageReference Include="Xamarin.AndroidX.Activity" Version="1.7.0" />
		<PackageReference Include="Xamarin.AndroidX.Activity.Compose" Version="1.7.0" />
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.6.1" />
		<PackageReference Include="Xamarin.AndroidX.Browser" Version="1.5.0" />
		<PackageReference Include="Xamarin.AndroidX.Compose.Foundation" Version="1.4.0" />
		<PackageReference Include="Xamarin.AndroidX.Compose.Material" Version="1.4.0" />
		<PackageReference Include="Xamarin.AndroidX.Compose.Material.Icons.Core" Version="1.4.0" />
		<PackageReference Include="Xamarin.AndroidX.Compose.Runtime" Version="1.4.0" />
		<PackageReference Include="Xamarin.AndroidX.Compose.UI" Version="1.4.0" />
		<PackageReference Include="Xamarin.AndroidX.Compose.UI.Tooling.Preview" Version="1.4.0" />
		<PackageReference Include="Xamarin.AndroidX.ConstraintLayout" Version="2.1.4.3" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.6.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.6.1" />
		<PackageReference Include="Xamarin.AndroidX.Security.SecurityCrypto" Version="1.1.0-alpha03" />
		<PackageReference Include="Xamarin.Google.Accompanist.FlowLayout" Version="0.30.0" />
		<PackageReference Include="Xamarin.Google.Android.Material" Version="1.8.0" />
		<PackageReference Include="Xamarin.Google.Dagger" Version="2.44.2.1" />
		<PackageReference Include="Xamarin.Kotlin.StdLib.Jdk7" Version="1.8.10" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\StripeCore\StripeCore.csproj" />
	  <ProjectReference Include="..\StripeFinancialConnections\StripeFinancialConnections.csproj" />
	  <ProjectReference Include="..\StripePaymentCore\StripePaymentCore.csproj" />
	  <ProjectReference Include="..\StripePaymentModel\StripePaymentModel.csproj" />
	  <ProjectReference Include="..\StripePaymentsUiCore\StripePaymentsUiCore.csproj" />
	  <ProjectReference Include="..\StripeUiCore\StripeUiCore.csproj" />
	</ItemGroup>
</Project>