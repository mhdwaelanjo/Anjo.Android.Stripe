<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net7.0-android;net6.0-android;</TargetFrameworks>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>Anjo.Android.Stripe.PaymentCore</PackageId>
		<PackageVersion>20.34.4</PackageVersion>
		<AssemblyVersion>20.34.4</AssemblyVersion>
		<FileVersion>20.34.4</FileVersion>
		<Version>20.34.4</Version>
		<Title>Anjo Android Stripe PaymentCore SDK</Title>
		<Authors>Wael Anjo</Authors>
		<Owners>Wael Anjo</Owners>
		<PackageProjectUrl>https://github.com/mhdwaelanjo/Anjo.Android.Stripe</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<Description>.NET for Android (formerly Xamarin.Android) Binding Library - Stripe PaymentCore SDK</Description>
		<PackageReleaseNotes>Stripe.PaymentCore SDK v20.34.4</PackageReleaseNotes>
		<Copyright>Copyright (c) 2023 Wael Anjo</Copyright>
		<PackageTags>Xamarin.Android, MonoDroid, Stripe, credit cards, Payment Gateway, money</PackageTags>
		<Summary>With Stripe Payments, collect payments, make payouts, manage international payments and more.</Summary>
		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="Jars\payments-core-20.34.4.aar" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Anjo.Google.Android.InstantApps" Version="1.1.0.1" />
		<PackageReference Include="Xamarin.Android.JetBrains.Kotlin_Parcelize_Runtime" Version="1.5.20.1" />
		<PackageReference Include="Xamarin.AndroidX.Activity" Version="1.8.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Activity.Compose" Version="1.8.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.7.0.2" />
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.6.1.5" />
		<PackageReference Include="Xamarin.AndroidX.Browser" Version="1.6.0.2" />
		<PackageReference Include="Xamarin.AndroidX.ConstraintLayout" Version="2.1.4.8" />
		<PackageReference Include="Xamarin.AndroidX.DataBinding.ViewBinding" Version="8.1.2.1" />
		<PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.6.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.6.2.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.6.2.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.6.2.2" />
		<PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.3.2" />
		<PackageReference Include="Xamarin.Google.Android.Material" Version="1.10.0.1" />
		<PackageReference Include="Xamarin.Google.Dagger" Version="2.47.0.1" />
		<PackageReference Include="Xamarin.GooglePlayServices.Wallet" Version="119.2.1.1" />
		<PackageReference Include="Xamarin.Kotlin.StdLib.Jdk7" Version="1.9.20" />
		<PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.7.3.2" />
		<PackageReference Include="Xamarin.KotlinX.Coroutines.Core" Version="1.7.3.2" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Stripe3DS2\Stripe3DS2.csproj" />
		<ProjectReference Include="..\StripeCore\StripeCore.csproj" />
		<ProjectReference Include="..\StripePaymentModel\StripePaymentModel.csproj" />
	</ItemGroup>
</Project>